{"task_id": "oculta-codigo-01", "category": "codigo", "difficulty": "easy", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 2.98, "in_tok": 90, "out_tok": 44, "error": null, "response": "```python\ndef suma_digitos(n):\n    total = 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total\n```"}
{"task_id": "oculta-codigo-02", "category": "codigo", "difficulty": "easy", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 5.43, "in_tok": 81, "out_tok": 93, "error": null, "response": "```python\ndef count_words(sentence):\n    # Remove punctuation and convert to lowercase\n    cleaned_sentence = sentence.lower().translate(str.maketrans('', '', '.,!?\";:()[]{}'))\n    # Split into words and count occurrences\n    words = cleaned_sentence.split()\n    word_count = {}\n    for word in words:\n        word_count[word] = word_count.get(word, 0) + 1\n    return word_count\n```"}
{"task_id": "oculta-codigo-03", "category": "codigo", "difficulty": "easy", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 7.48, "in_tok": 82, "out_tok": 86, "error": null, "response": "```python\ndef es_primo(n):\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n```"}
{"task_id": "oculta-codigo-04", "category": "codigo", "difficulty": "hard", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 8.33, "in_tok": 100, "out_tok": 96, "error": null, "response": "```python\ndef rotar_matriz(matriz):\n    n = len(matriz)\n    # Crear una nueva matriz para almacenar el resultado\n    resultado = [[0] * n for _ in range(n)]\n    # Rotar 90 grados en sentido horario\n    for i in range(n):\n        for j in range(n):\n            resultado[j][n - 1 - i] = matriz[i][j]\n    return resultado\n```"}
{"task_id": "oculta-codigo-05", "category": "codigo", "difficulty": "hard", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 5.33, "in_tok": 81, "out_tok": 62, "error": null, "response": "```python\ndef longest_common_prefix(strings):\n    if not strings:\n        return ''\n    result = ''\n    for chars in zip(*strings):\n        if all(c == chars[0] for c in chars):\n            result += chars[0]\n        else:\n            break\n    return result\n```"}
{"task_id": "oculta-codigo-06", "category": "codigo", "difficulty": "hard", "private": false, "brain": "local", "model": "qwen3:4b-instruct-2507-q4_K_M", "score": 1.0, "cost_usd": 0.0, "latency_s": 7.29, "in_tok": 101, "out_tok": 133, "error": null, "response": "```python\ndef k_mas_frecuentes(lista, k):\n    if k <= 0:\n        return []\n    if not lista:\n        return []\n    \n    # Contar frecuencia de cada elemento\n    frecuencias = {}\n    for elemento in lista:\n        frecuencias[elemento] = frecuencias.get(elemento, 0) + 1\n    \n    # Ordenar por frecuencia (de mayor a menor) y tomar los k primeros\n    elementos_ordenados = sorted(frecuencias.keys(), key=lambda x: frecuencias[x], reverse=True)\n    \n    return elementos_ordenados[:k]\n```"}
